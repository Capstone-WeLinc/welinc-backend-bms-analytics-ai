# ============================================================================
# WeLinc Backend — Analytics & AI (standalone) — environment configuration
# Copy this file to .env (the main backend's .env is a valid starting point).
# ============================================================================

# Port for this standalone backend (the main BMS backend owns :3000)
PORT=3001
CORS_ORIGINS=http://127.0.0.1:5174,http://localhost:5174

# PostgreSQL database that holds the Booking/Vehicle/Driver data the analytics
# read from (same Postgres as the main BMS — docker compose on :5433).
DATABASE_URL="postgresql://welinc_user:welinc_pass@localhost:5433/welinc_db?schema=public"

# !!! JWT_SECRET MUST equal the MAIN backend's JWT_SECRET (welinc-backend/.env) !!!
# Tokens are minted by the main backend's /auth/login; this backend only VERIFIES
# them, so an identical secret is required or every request returns 401.
JWT_SECRET=change-me-to-match-main-backend
JWT_ACCESS_EXPIRY=8h

# Groq API key for the AI demand forecast. REQUIRED — the server refuses to boot
# with an empty key (groq-sdk throws). A dummy key boots fine; forecast calls
# then fail and the deterministic fallback forecast is used instead.
GROQ_API_KEY=
# The AI Insights tab asks llama-3.3-70b-versatile first. If that model is not
# available for the key, this model is used instead (the UI names the model used).
# The LLM only interprets the computed forecast; it never produces the numbers.
GROQ_MODEL=openai/gpt-oss-120b

# Dispatch service, read with the signed-in Admin's token for truck, driver,
# helper and schedule availability (Resource Planning). Defaults to this URL.
DISPATCH_API_URL=http://127.0.0.1:3003

# Docker Compose MySQL is published on host port 3307 (container port 3306).
# Match the main backend's .env while both backends use the same report database.
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3307
MYSQL_USER=root
MYSQL_PASSWORD=root
MYSQL_DATABASE=welinc
