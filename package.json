{
  "name": "welinc-backend-bms-analytics-ai",
  "version": "0.0.1",
  "private": true,
  "description": "Standalone NestJS backend for WeLinc analytics & AI (reports, Groq demand forecast)",
  "scripts": {
    "build": "prisma generate && nest build",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:prod": "node dist/src/main.js",
    "prisma:generate": "prisma generate",
    "typecheck": "tsc --noEmit",
    "test": "node -r ts-node/register --test test/forecasting.test.ts test/operational-report.test.ts",
    "evaluate:forecast": "ts-node -r tsconfig-paths/register scripts/evaluate-forecast-accuracy.ts",
    "test:auth": "jest --runInBand",
    "seed": "node prisma/seed.mjs",
    "lint:ci": "eslint ."
  },
  "dependencies": {
    "@nestjs/common": "^11.0.1",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.0.1",
    "@nestjs/platform-express": "^11.0.1",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "groq-sdk": "^1.3.0",
    "pg": "^8.21.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "jose": "^6.0.0"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.0",
    "@types/express": "^5.0.0",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.20.0",
    "dotenv": "^17.4.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.7.3",
    "jest": "^30.0.0",
    "@types/jest": "^30.0.0",
    "ts-jest": "^29.4.15",
    "prisma": "7.10.1",
    "eslint": "^9.34.0",
    "@eslint/js": "^9.34.0",
    "globals": "^17.14.0",
    "typescript-eslint": "^8.42.0"
  },
  "engines": {
    "node": "24.x"
  },
  "jest": {
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "testEnvironment": "node",
    "transform": {
      "^.+\\.(t|j)s$": [
        "ts-jest",
        {
          "tsconfig": {
            "allowJs": true,
            "module": "commonjs",
            "moduleResolution": "node10",
            "resolvePackageJsonExports": false
          }
        }
      ]
    },
    "transformIgnorePatterns": [
      "/node_modules/(?!jose/)"
    ]
  }
}
